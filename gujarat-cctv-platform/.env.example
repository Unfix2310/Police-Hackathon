DATABASE_URL=postgresql+asyncpg://cctv_user:cctv_pass_2026@postgres:5432/cctv_platform
DATABASE_URL_SYNC=postgresql://cctv_user:cctv_pass_2026@localhost:5432/cctv_platform
REDIS_URL=redis://redis:6379/0

# Auth
JWT_SECRET=your-secure-256-bit-secret-key-replace-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480

# AI Pipeline
DETECTION_CONFIDENCE_THRESHOLD=0.5
ANPR_CONFIDENCE_THRESHOLD=0.6
FRAME_SAMPLE_RATE=2
TRACKING_IOU_THRESHOLD=0.3
REID_SIMILARITY_THRESHOLD=0.75

# Paths
RECORDINGS_PATH=/app/data/recordings
MODELS_PATH=/app/data/models
FRAMES_OUTPUT_PATH=/app/data/frames

# Server
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Sentinel Camera Grid Integration
SENTINEL_EMAIL=your-email@example.com
SENTINEL_PASSWORD=your-sentinel-password
SENTINEL_CDN_HOST=https://cctv.corp8.cloud
SENTINEL_RTSP_IP=103.250.160.189
SENTINEL_RTSP_PORT=8554
SENTINEL_WHEP_PORT=8889
